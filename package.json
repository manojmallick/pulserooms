{
  "name": "pulserooms",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time global trivia battle royale — Amazon DynamoDB single-table design with a write-sharded leaderboard built to scale to millions of concurrent answers",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "ddb:provision": "node --env-file=.env.local scripts/provision-table.mjs",
    "ddb:seed": "node --env-file=.env.local scripts/seed.mjs",
    "ddb:reset": "node --env-file=.env.local scripts/provision-table.mjs --recreate && node --env-file=.env.local scripts/seed.mjs",
    "ddb:clean": "node --env-file=.env.local scripts/clean-loadtest.mjs",
    "ddb:crowd": "node --env-file=.env.local scripts/seed-crowd.mjs",
    "ddb:backfill": "node --env-file=.env.local scripts/backfill-profiles.mjs",
    "ddb:ttl": "node --env-file=.env.local scripts/enable-ttl.mjs",
    "gt:status": "node --env-file=.env.local scripts/global-tables.mjs --status",
    "gt:enable": "node --env-file=.env.local scripts/global-tables.mjs",
    "gt:disable": "node --env-file=.env.local scripts/global-tables.mjs --disable",
    "loadtest": "node --env-file=.env.local scripts/loadtest.mjs",
    "loadgen:deploy": "node --env-file=.env.local scripts/deploy-loadgen.mjs",
    "loadgen": "node --env-file=.env.local scripts/loadgen.mjs",
    "loadtable:up": "node --env-file=.env.local scripts/provision-load-table.mjs",
    "loadtable:down": "node --env-file=.env.local scripts/provision-load-table.mjs --delete",
    "proof": "node --env-file=.env.local scripts/proof.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.658.0",
    "@aws-sdk/client-cloudwatch": "^3.1075.0",
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-iam": "^3.658.0",
    "@aws-sdk/client-lambda": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/functions": "^3.7.2",
    "@vercel/oidc-aws-credentials-provider": "^3.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3"
  }
}
