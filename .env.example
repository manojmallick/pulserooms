# ─────────────────────────────────────────────────────────────
# PulseRooms environment. Copy to .env.local (git-ignored).
# Never commit real credentials.
# ─────────────────────────────────────────────────────────────

# ── AWS region ────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── DynamoDB auth (two modes, auto-detected by lib/dynamo.ts) ──
# PREFERRED: Vercel OIDC → AWS role federation (no static keys).
#   Connect the project to an AWS account / set the deploy role, then:
#     vercel env pull .env.local
#   which provides AWS_ROLE_ARN + a short-lived VERCEL_OIDC_TOKEN.
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/pulserooms-deploy
# VERCEL_OIDC_TOKEN=...   # injected by `vercel env pull` (short-lived)

# FALLBACK: static keys for local provisioning / seeding.
# Needs dynamodb:* on the PulseRooms table.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=     # only if using temporary credentials

# ── Table + sharding ──────────────────────────────────────────
PULSEROOMS_TABLE=PulseRooms
# Number of write shards per room leaderboard partition. The hot-partition fix.
# Must match between writes and scatter-gather reads. 10 is a sane default;
# bump for rooms expected to exceed ~1k writes/sec sustained.
LEADERBOARD_SHARDS=10

# Active season for the global seasonal leaderboard (GSI2).
SEASON_ID=2026-S1

# ── Realtime fanout (Upgrade #3 — optional, AWS-side) ─────────
# API Gateway WebSocket @connections endpoint, used by the Streams Lambda to
# push leaderboard deltas to connected clients. Leave blank for local dev
# (the UI falls back to polling /api/leaderboard).
# WS_API_ENDPOINT=https://abc123.execute-api.us-east-1.amazonaws.com/prod
